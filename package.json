{
  "name": "docsera-repo",
  "private": true,
  "description": "Repository-level validation surface for Docsera frontend and scaffolding",
  "scripts": {
    "build:sdk-global-bridge": "npm --prefix app/docsera-global-bridge run build",
    "generate:update-set-global-bridge": "npm --prefix app/docsera-global-bridge run generate:update-set --",
    "build:update-set-global-bridge": "npm run build:sdk-global-bridge && npm run generate:update-set-global-bridge",
    "build:sdk-ui-page": "npm --prefix app/docsera-ui run build",
    "deploy:sdk-ui-page": "npm --prefix app/docsera-ui run deploy:sdk",
    "install:sdk-global-bridge": "npm --prefix app/docsera-global-bridge run install:sdk --",
    "install:sdk-ui-page": "npm --prefix app/docsera-ui run install:sdk --",
    "transform:sdk-ui-page": "npm --prefix app/docsera-ui run transform:sdk --",
    "types:sdk-ui-page": "npm --prefix app/docsera-ui run types:sdk",
    "verify:sdk-global-bridge": "npm --prefix app/docsera-global-bridge run verify:sdk --",
    "verify:sdk-ui-page": "npm --prefix app/docsera-ui run verify:sdk-runtime --",
    "verify:workspace-bridge-ping": "npm --prefix app/docsera-ui run verify:workspace-bridge-ping --",
    "verify:workspace-foundation": "npm --prefix app/docsera-ui run verify:workspace-foundation --",
    "reset:editor-smoke-data": "npm --prefix app/docsera-ui run reset:editor-smoke-data",
    "reset:editor-smoke-data:apply": "npm --prefix app/docsera-ui run reset:editor-smoke-data:apply",
    "ensure:task-worktree": "node scripts/ensure-task-worktree.mjs",
    "convert:sdk-identity": "node scripts/convert-sdk-identity.mjs",
    "setup:developer-instance": "node scripts/setup-developer-instance-identity.mjs",
    "test:sdk-identity-conversion": "node --test scripts/convert-sdk-identity.test.mjs",
    "test:developer-instance-identity-setup": "node --test scripts/setup-developer-instance-identity.test.mjs",
    "test:task-worktree-guard": "node --test scripts/ensure-task-worktree.test.mjs",
    "validate": "npm run validate:frontend && npm run validate:shell && npm run validate:docs",
    "validate:frontend": "npm --prefix app/docsera-ui run validate",
    "validate:shell": "npm --prefix app/docsera-shell run verify",
    "validate:docs": "node scripts/validate-docsera-docs.mjs",
    "package:direct-ui-page": "node scripts/package-direct-ui-page-assets.mjs",
    "verify": "npm run validate"
  }
}
