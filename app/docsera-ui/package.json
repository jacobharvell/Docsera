{
  "name": "docsera-direct-ui-page-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "SDK-native React + TypeScript baseline for the Docsera standalone Direct UI Page runtime",
  "type": "module",
  "imports": {
    "#now:*": "./@types/servicenow/fluent/*/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node ./scripts/clean-sdk-build.mjs",
    "dev": "now-sdk run dev",
    "build": "now-sdk build",
    "install:sdk": "node ./scripts/verify-sdk-install-prereqs.mjs && npm run build && now-sdk install",
    "deploy:sdk": "npm run clean && npm run build && node ./scripts/verify-sdk-install-prereqs.mjs && now-sdk install && npm run verify:sdk-runtime",
    "transform:sdk": "now-sdk transform",
    "types:sdk": "now-sdk dependencies",
    "verify:editor-runtime-boundary": "node ./scripts/verify-editor-runtime-boundary.mjs",
    "verify:inline-runtime-css-build": "node ./scripts/verify-inline-runtime-css-build.mjs",
    "verify:sdk-runtime": "node ./scripts/verify-sdk-runtime.mjs",
    "verify:standalone-layout": "node ./scripts/verify-standalone-layout.mjs",
    "verify:e3-t9-mutation-conversion": "node ./scripts/verify-e3-t9-mutation-conversion.mjs",
    "verify:e3-t10-page-movement": "node ./scripts/verify-e3-t10-page-movement.mjs",
    "verify:e3-t11-changes-center": "node ./scripts/verify-e3-t11-changes-center.mjs",
    "verify:workspace-edit-lease": "node ./scripts/verify-workspace-edit-lease.mjs",
    "verify:workspace-edit-lease-browser": "node ./scripts/workspace-edit-lease-browser-smoke.mjs",
    "verify:workspace-foundation": "node ./scripts/verify-workspace-foundation.mjs",
    "reset:editor-smoke-data": "node ./scripts/reset-editor-smoke-data.mjs",
    "reset:editor-smoke-data:apply": "node ./scripts/reset-editor-smoke-data.mjs --apply",
    "test": "node ./scripts/run-managed-vitest.mjs",
    "validate": "node ./scripts/run-managed-validate.mjs"
  },
  "dependencies": {
    "@tiptap/core": "3.27.3",
    "@tiptap/extension-document": "3.27.3",
    "@tiptap/extension-link": "3.27.3",
    "@tiptap/extension-list": "3.27.3",
    "@tiptap/pm": "3.27.3",
    "@tiptap/react": "3.27.3",
    "@tiptap/starter-kit": "3.27.3",
    "lucide-react": "^1.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@napi-rs/keyring": "1.2.0",
    "@servicenow/glide": "27.0.5",
    "@servicenow/isomorphic-rollup": "^1.3.6",
    "@servicenow/sdk": "4.8.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "jsdom": "^25.0.1",
    "playwright-core": "^1.61.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
